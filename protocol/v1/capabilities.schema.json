{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coding-agent:runtime-ipc:v1:capabilities",
  "title": "Coding Agent Runtime IPC v1 Protocol Information",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "kind",
    "runtime_name",
    "runtime_version",
    "supported_protocol_versions",
    "capabilities",
    "backend_kinds",
    "sandbox_modes",
    "schema_digests",
    "limits",
    "extensions"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "kind": {
      "const": "protocol_info"
    },
    "runtime_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "supported_protocol_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "contains": {
        "const": 1
      },
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    },
    "backend_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9.-]*$"
      }
    },
    "sandbox_modes": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    },
    "schema_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "execution_request",
        "event_envelope",
        "terminal_result"
      ],
      "properties": {
        "capabilities": {"$ref": "#/$defs/sha256"},
        "execution_request": {"$ref": "#/$defs/sha256"},
        "event_envelope": {"$ref": "#/$defs/sha256"},
        "terminal_result": {"$ref": "#/$defs/sha256"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_request_bytes", "max_record_bytes"],
      "properties": {
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "max_record_bytes": {
          "type": "integer",
          "minimum": 1024
        }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
