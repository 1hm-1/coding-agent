{
  "candidate_additive_mappings": {
    "historical_conversation": "one synthetic Conversation per legacy Session when no product conversation provenance exists",
    "historical_turn": "one synthetic Turn representing the legacy one-shot task, linked to its RuntimeExecution",
    "legacy_session": "RuntimeExecution identity retained as compatibility identifier; M1 decides whether the key is reused or related by an explicit mapping",
    "rule": "never rewrite legacy payloads, traces, IPC v1, or evidence into target terminology"
  },
  "database_schema_version": 4,
  "failure_contract": [
    "each existing migration is BEGIN IMMEDIATE and rolls back the failing version atomically",
    "already applied versions remain committed when a later version fails",
    "rerun is idempotent",
    "any recorded version above 4 raises FutureSchemaVersion before new migration work"
  ],
  "legacy_identifier_surfaces": {
    "cli": [
      "--session-id",
      "sessions",
      "show",
      "resume",
      "interrupt",
      "resolve-call",
      "replay",
      "export-trace"
    ],
    "database": [
      "sessions.id",
      "messages.session_id",
      "events.session_id",
      "checkpoints.session_id",
      "model_calls.session_id",
      "tool_calls.session_id",
      "summaries.session_id",
      "memory_retrievals.session_id"
    ],
    "python_api": [
      "RunResult.session_id",
      "AgentApplication.resume_session(session_id)",
      "AgentApplication.interrupt_session(session_id)"
    ],
    "runtime_ipc": [
      "session_id in v1 requests, events, results, and error context"
    ],
    "trace_and_evidence": [
      "JSONL event session_id",
      "replay output session_id",
      "eval run/result session_id when exported"
    ]
  },
  "m1_owned_decisions": [
    "physical Conversation/Turn/RuntimeExecution tables and keys",
    "legacy Session-to-execution mapping cardinality and durable linkage",
    "synthetic historical object provenance markers",
    "backfill batching and mixed-version read/write sequencing",
    "rollback/recovery checkpoint for additive backfill",
    "public API naming and compatibility aliases outside frozen IPC v1"
  ],
  "migration_versions": {
    "1": 4,
    "2": 9,
    "3": 3,
    "4": 7
  },
  "preserve": [
    "message order and tool_call_id uniqueness",
    "event sequence and payload bytes/meaning",
    "checkpoint RuntimeSnapshot and optimistic version",
    "model request/response/error journals and attempts",
    "tool arguments/results/errors, revisions, recovery mode, and attempts",
    "summary lineage, source range/hash, revision, supersession, and staleness",
    "lease owner/expiry, interrupt request, resume target, and context version",
    "Memory records, lifecycle events, retrieval audit, scope, status, and provenance"
  ],
  "readers_to_preserve": [
    "SQLiteRunJournal",
    "run_task and resume_session",
    "legacy CLI session commands",
    "Runtime IPC v1",
    "JSONL export/replay and semantic replay",
    "evaluation reports/oracles",
    "Memory store/governance readers"
  ],
  "required_fixtures": [
    "terminal completed and failed",
    "interrupted before and during calls",
    "retrying model and tool calls",
    "uncertain model and tool effects",
    "WAITING_APPROVAL reconciliation",
    "committed response reuse",
    "mixed v1-v4 historical data including summaries and Memory records"
  ],
  "schema_version": 1,
  "serialized_format_rule": "Formats without an embedded version are catalogued as legacy-unversioned-v0, not inferred as schema v1. M1 must preserve their raw content and current readers or introduce an explicit, tested compatibility mapping; the SQLite schema version alone is not a payload version.",
