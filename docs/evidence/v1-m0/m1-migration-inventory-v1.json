    {
      "accepted_read_versions": [
        1,
        2
      ],
      "columns": [
        "checkpoints.snapshot_json"
      ],
      "compatibility_requirement": "M1 must retain v1 and v2 reads and write v2 until an independently authorized versioned migration changes the contract.",
      "current_write_version": 2,
      "format_id": "runtime_snapshot",
      "reader": "RuntimeSnapshot.from_json/from_dict via SQLiteRunJournal.load_snapshot",
      "version_field": "snapshot_version",
